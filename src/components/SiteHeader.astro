---
const { currentPath } = Astro.props;
const base = import.meta.env.BASE_URL;
const links = [
  ["/", "Dashboard"], ["/thesis/", "Thesis"], ["/evidence/", "Evidence"],
  ["/economics/", "Economics"], ["/power-sites/", "Power & sites"], ["/workloads/", "Workloads"],
  ["/assumptions-decisions/", "Registers"], ["/research-queue/", "Queue"], ["/sources-timeline/", "Sources"]
];
const withBase = (href: string) => href === "/" ? base : `${base}${href.slice(1)}`;
const normalise = (href: string) => href.endsWith("/") ? href : `${href}/`;
---
<header class="site-header">
  <a class="wordmark" href={base}>Distributed inference<span>Australia · research cockpit</span></a>
  <nav class="site-nav" aria-label="Primary navigation">
    {links.map(([href, label]) => {
      const target = withBase(href);
      return <a href={target} aria-current={normalise(currentPath) === normalise(target) ? "page" : undefined}>{label}</a>;
    })}
  </nav>
</header>

---
import "../styles/global.css";
import SiteHeader from "../components/SiteHeader.astro";
interface Props { title: string; description?: string; wide?: boolean; }
const { title, description = "Repository-first research cockpit for Distributed Inference Australia.", wide = false } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href={`${base}assets/mark.svg`} type="image/svg+xml" />
    <title>{title} · Distributed Inference Australia</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="site-rail">
      <SiteHeader currentPath={Astro.url.pathname} />
      <main id="main" class:list={["page", wide && "page-wide"]}><slot /></main>
      <footer class="site-footer">Research working system · sources and review dates remain attached to each claim</footer>
    </div>
  </body>
</html>

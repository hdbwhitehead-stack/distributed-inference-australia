---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import { freshnessLabel } from "../lib/freshness";
import { dateText, list, recordSummary, recordTitle, text, type ResearchRecord } from "../lib/content";
const [evidence, sources] = await Promise.all([getCollection("evidence"), getCollection("sources")]);
const records = evidence as unknown as ResearchRecord[];
const sourceLookup = new Map((sources as unknown as ResearchRecord[]).map((source) => [source.id, source.data.url]));
const base = import.meta.env.BASE_URL;
const unique = (values: string[]) => [...new Set(values.filter(Boolean))].sort();
const themes = unique(records.flatMap((record) => list(record.data.themes)));
const confidences = unique(records.map((record) => String(record.data.confidence ?? "")));
const sourceTypes = unique(records.map((record) => String(record.data.source_type ?? "")));
const stances = unique(records.map((record) => String(record.data.stance ?? "")));
---
<BaseLayout title="Evidence" wide={true}>
  <PageHeader eyebrow="Evidence archive" title={'Claims with their source, date and <span class="marker">degree of confidence</span>.'} lede="Search uses every word you supply. Filter by stance, theme, confidence, source type or freshness. A missing result is an invitation to widen the query, not a hidden score." meta={`${records.length} evidence records · press / to search`} />
  <div class="toolbar" data-evidence-controls>
    <label><span class="control-label">Search <kbd>/</kbd></span><input class="control" type="search" placeholder="Claim, source, theme or identifier" data-evidence-search /></label>
    <label><span class="control-label">Stance</span><select class="control" data-filter="stance"><option value="">All</option>{stances.map((item) => <option value={item}>{item}</option>)}</select></label>
    <label><span class="control-label">Theme</span><select class="control" data-filter="theme"><option value="">All</option>{themes.map((item) => <option value={item}>{item}</option>)}</select></label>
    <label><span class="control-label">Confidence</span><select class="control" data-filter="confidence"><option value="">All</option>{confidences.map((item) => <option value={item}>{item}</option>)}</select></label>
    <label><span class="control-label">Source type</span><select class="control" data-filter="source"><option value="">All</option>{sourceTypes.map((item) => <option value={item}>{item}</option>)}</select></label>
    <label><span class="control-label">Freshness</span><select class="control" data-filter="freshness"><option value="">All</option><option value="current">Current</option><option value="review">Review due</option><option value="stale">Stale</option><option value="unknown">Unknown</option></select></label>
  </div>
  <p class="result-count" role="status" aria-live="polite"><span data-result-count>{records.length}</span> records shown</p>
  <p class="empty-state" hidden data-evidence-empty>No records match those terms and filters. Clear one filter or search for a shorter, more general term.</p>
  <section class="evidence-grid" data-evidence-list>
    {records.map((record) => {
      const sourceIds = list(record.data.source_ids);
      const sourceUrl = sourceIds.map((id) => sourceLookup.get(id)).find((value): value is string => typeof value === "string");
      const search = [record.id, recordTitle(record), recordSummary(record), record.data.source_name, record.data.source_type, record.data.stance, record.data.confidence, record.data.next_verification, ...list(record.data.themes), ...list(record.data.implications)].filter(Boolean).join(" ").toLowerCase();
      const reviewed = record.data.reviewed_at ?? record.data.updated_at;
      return <article class="evidence-card" data-evidence-card data-search={search} data-stance={String(record.data.stance ?? "")} data-themes={list(record.data.themes).join("|")} data-confidence={String(record.data.confidence ?? "")} data-source={String(record.data.source_type ?? "")} data-freshness={freshnessLabel(reviewed).replace(" due", "")}>
        <div class="evidence-card__top"><span class:list={["tag", `tag--${String(record.data.stance ?? "")}`]}>{text(record.data.stance, "context")}</span><span class="record-meta">{text(record.data.confidence, "unrated")}</span></div>
        <h2>{recordTitle(record)}</h2><p>{recordSummary(record)}</p>
        <p class="record-meta">{list(record.data.themes).join(" · ") || "no theme"}</p>
        {list(record.data.implications).length ? <div class="evidence-card__details"><p class="mono-label">Implications to test</p><ul>{list(record.data.implications).map((item) => <li>{item}</li>)}</ul></div> : null}
        {typeof record.data.next_verification === "string" ? <div class="evidence-card__details"><p class="mono-label">Next verification</p><p>{record.data.next_verification}</p></div> : null}
        <div class="evidence-card__footer">{text(record.data.source_type, "source type unknown")} · reviewed {dateText(reviewed)} · {freshnessLabel(reviewed)}</div>
        <p>{sourceUrl ? <a href={sourceUrl} target="_blank" rel="noreferrer">Open source ↗</a> : sourceIds.length ? <a href={`${base}sources-timeline/#${sourceIds[0]}`}>Open source record →</a> : <a href={`${base}sources-timeline/`}>Open source register →</a>}{list(record.data.related_theses).length ? <> · <a href={`${base}thesis/`}>Related thesis →</a></> : null}</p>
      </article>;
    })}
  </section>
  <script>
    const search = document.querySelector<HTMLInputElement>("[data-evidence-search]");
    const filters = Array.from(document.querySelectorAll<HTMLSelectElement>("[data-filter]"));
    const cards = Array.from(document.querySelectorAll<HTMLElement>("[data-evidence-card]"));
    const count = document.querySelector("[data-result-count]");
    const empty = document.querySelector<HTMLElement>("[data-evidence-empty]");
    const update = () => {
      const terms = (search?.value.toLowerCase() ?? "").trim().split(/\s+/).filter(Boolean);
      let visible = 0;
      for (const card of cards) {
        const matchesTerms = terms.every((term) => (card.dataset.search ?? "").includes(term));
        const matchesFilters = filters.every((filter) => {
          if (!filter.value) return true;
          const key = filter.dataset.filter;
          if (key === "theme") return (card.dataset.themes ?? "").split("|").includes(filter.value);
          return card.dataset[key ?? ""] === filter.value;
        });
        const show = matchesTerms && matchesFilters;
        card.hidden = !show;
        if (show) visible += 1;
      }
      if (count) count.textContent = String(visible);
      if (empty) empty.hidden = visible !== 0;
    };
    search?.addEventListener("input", update);
    filters.forEach((filter) => filter.addEventListener("change", update));
    document.addEventListener("keydown", (event) => {
      const target = event.target as HTMLElement | null;
      const editable = target?.matches("input, textarea, select, [contenteditable='true']");
      if (event.key === "/" && !editable) { event.preventDefault(); search?.focus(); }
    });
  </script>
</BaseLayout>

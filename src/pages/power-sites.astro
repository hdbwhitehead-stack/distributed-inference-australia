---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import CandidateSiteMap from "../components/CandidateSiteMap.astro";
import Frame from "../components/Frame.astro";
import PageHeader from "../components/PageHeader.astro";
import { type ResearchRecord } from "../lib/content";

const candidates = (await getCollection("sites")) as unknown as ResearchRecord[];
const decisions = (await getCollection("decisions")) as unknown as ResearchRecord[];
const sources = (await getCollection("sources")) as unknown as ResearchRecord[];
const designCase = decisions.find((record) => record.data.id === "decision-pilot-one-rack-design-case");
const load = designCase?.data.design_case as { rack_platform: string; rack_power_kw_low: number; rack_power_kw_high: number; pue: number; calculated_facility_kw_low: number; calculated_facility_kw_high: number; screening_envelope_kw: number; input_confidence: string } | undefined;
const checks = [
  ["Connection and boundary", "Where does the load sit electrically, and what do the agreement, transformer, protection and import limits actually permit?"],
  ["Usable energy shape", "What five-minute power is usable after ramps, interruptions, duration, recovery and ordinary intermittency?"],
  ["Delivered economics and value", "Does local physical value reach the operator after retail, network, losses, metering and contract terms?"],
  ["Fibre and latency", "Is there a credible route, price, latency and management path for the intended service?"],
  ["Thermal, physical and planning", "Can the facility cool, energise, operate and obtain access or approvals across real conditions?"],
  ["Counterparty, operations and security", "Can the relationships, controls, remote hands, model custody and failure responsibilities be underwritten?"],
];
---
<BaseLayout title="Power and sites" wide={true}>
  <PageHeader eyebrow="Power and site screening" title={'A location enters the register only when <span class="marker">evidence can follow it</span>.'} lede="A simple research notebook for candidate locations. Regional power signals can originate a lead; they cannot establish site capability or pilot readiness." meta={`${candidates.length} real candidate record${candidates.length === 1 ? "" : "s"} · ${load?.screening_envelope_kw ?? "undefined"} kW design case`} />

  {load && <section class="design-case-panel">
    <div class="design-case-formula" aria-label="Pilot design case calculation">
      <div><span>Rack estimate</span><strong>{load.rack_power_kw_low}–{load.rack_power_kw_high} kW</strong><small>{load.rack_platform} · {load.input_confidence} confidence</small></div>
      <b>×</b><div><span>PUE assumption</span><strong>{load.pue}</strong><small>Open project assumption</small></div>
      <b>=</b><div><span>Facility load</span><strong>{load.calculated_facility_kw_low}–{load.calculated_facility_kw_high} kW</strong><small>Calculated, not measured</small></div>
      <b>→</b><div class="design-case-result"><span>Screening envelope</span><strong>{load.screening_envelope_kw} kW</strong><small>Rounded planning case</small></div>
    </div>
    <p class="design-case-caption">External input → project assumption → arithmetic → reversible decision. This is not a site's import capability, expected draw or customer reservation.</p>
  </section>}

  <div class="section-heading"><h2>Candidate register and location index</h2><span>Empty is valid</span></div>
  <CandidateSiteMap candidates={candidates} sources={sources} designCase={designCase} />

  <div class="section-heading"><h2>Six questions before a shortlist</h2><span>Broad checks · evidence decides</span></div>
  <div class="screening-questions">{checks.map(([title, question]) => <section><p class="mono-label">{title}</p><p>{question}</p></section>)}</div>

  <Frame ticks={true}><div class="frame__body scope-note"><div><p class="mono-label">Program boundary</p><h2>A good site does not make a ready pilot</h2></div><p>Customer commitments, control-plane recovery, firm reserve, security, equipment terms and accepted-work economics remain project-level gates in PROJECT_STATE and the research queue. The map should not try to certify them.</p></div></Frame>
</BaseLayout>
